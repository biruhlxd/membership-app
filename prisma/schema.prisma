// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// A membership plan the merchant sells: one Shopify selling plan and the
// customer tag that marks its members.
model MembershipPlan {
  id                 String       @id @default(cuid())
  shop               String
  name               String
  sellingPlanId      String // gid://shopify/SellingPlan/...
  // Saved since 2026-10-31; older plans get them on first edit.
  sellingPlanGroupId String? // gid://shopify/SellingPlanGroup/...
  productId          String? // gid://shopify/Product/...
  // Member pricing: percent off for members, through an automatic discount
  // limited to a customer segment of this plan's tag.
  memberDiscount     Int?
  segmentId          String? // gid://shopify/Segment/...
  discountId         String? // gid://shopify/DiscountAutomaticNode/...
  // Organization plans: JSON list of seat types [{ name, tag, seats }]
  // (app/membership/organizations.ts). Null for a plan for one person.
  seatTypes          String?
  tag                String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  memberships        Membership[]

  @@unique([shop, sellingPlanId])
  @@unique([shop, tag])
}

// One member's membership: a mirror of one Shopify subscription contract.
model Membership {
  id                String           @id @default(cuid())
  shop              String
  contractId        String // gid://shopify/SubscriptionContract/...
  customerId        String // gid://shopify/Customer/...
  planId            String
  plan              MembershipPlan   @relation(fields: [planId], references: [id])
  contractStatus    String // ACTIVE, PAUSED, CANCELLED, EXPIRED, FAILED
  status            String // ACTIVE, PAST_DUE, PAUSED, LAPSED, CANCELLED
  // The cycle being billed and its failed attempts; reset when it is paid.
  currentCycleIndex Int?
  failedAttempts    Int              @default(0)
  nextAttemptAt     DateTime?
  // Shown on the Members page; refreshed from Shopify on every change.
  nextRenewalAt     DateTime?
  nextRenewalAmount String? // decimal, e.g. "90.00"
  currency          String?
  lastPaidAt        DateTime?
  // Set when the member cancels: access lasts until the paid period ends.
  accessEndsAt      DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  billingAttempts   BillingAttempt[]

  @@unique([shop, contractId])
  @@index([shop, customerId])
  @@index([nextAttemptAt])
}

// Every charge the app asks Shopify to make. The idempotency key is unique,
// so the same attempt can never be recorded or charged twice.
model BillingAttempt {
  id               String     @id @default(cuid())
  membershipId     String
  membership       Membership @relation(fields: [membershipId], references: [id])
  cycleIndex       Int
  attempt          Int
  idempotencyKey   String     @unique
  shopifyAttemptId String?    @unique // gid://shopify/SubscriptionBillingAttempt/...
  state            String // PENDING, SUCCEEDED, FAILED, ACTION_REQUIRED, REFUSED, UNKNOWN
  errorCode        String?
  orderId          String? // gid://shopify/Order/... when it succeeds
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([membershipId, cycleIndex, attempt])
}

// Every member email the app has sent (or logged, before an email provider is
// connected). The unique key stops the same email going twice.
model EmailLog {
  id           String   @id @default(cuid())
  membershipId String
  kind         String // RENEWAL_REMINDER, PAYMENT_FAILED, LAPSED
  key          String // see emailKey in app/membership/emails.ts
  to           String
  subject      String
  delivery     String // LOGGED or SENT
  createdAt    DateTime @default(now())

  @@unique([membershipId, kind, key])
}

// An organization: the customer who bought an organization plan, and the
// seats they hand out. One per organization membership.
model Organization {
  id              String   @id @default(cuid())
  shop            String
  membershipId    String   @unique
  adminCustomerId String // gid://shopify/Customer/...
  createdAt       DateTime @default(now())
  seats           Seat[]

  @@index([shop, adminCustomerId])
}

// A seat in an organization: invited by email, then accepted by the customer
// with that email. An ACTIVE seat gives its tag while the organization's
// membership grants access.
model Seat {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  tag            String // the seat type's tag
  email          String // lower case
  customerId     String? // set when accepted
  status         String // INVITED, ACTIVE, ENDED
  invitedAt      DateTime     @default(now())
  acceptedAt     DateTime?
  endedAt        DateTime?

  @@index([organizationId, status])
  @@index([email, status])
  @@index([customerId, status])
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// A membership plan the merchant sells: one Shopify selling plan and the
// customer tag that marks its members.
model MembershipPlan {
  id            String       @id @default(cuid())
  shop          String
  name          String
  sellingPlanId String // gid://shopify/SellingPlan/...
  tag           String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  memberships   Membership[]

  @@unique([shop, sellingPlanId])
  @@unique([shop, tag])
}

// One member's membership: a mirror of one Shopify subscription contract.
model Membership {
  id                String           @id @default(cuid())
  shop              String
  contractId        String // gid://shopify/SubscriptionContract/...
  customerId        String // gid://shopify/Customer/...
  planId            String
  plan              MembershipPlan   @relation(fields: [planId], references: [id])
  contractStatus    String // ACTIVE, PAUSED, CANCELLED, EXPIRED, FAILED
  status            String // ACTIVE, PAST_DUE, PAUSED, LAPSED, CANCELLED
  // The cycle being billed and its failed attempts; reset when it is paid.
  currentCycleIndex Int?
  failedAttempts    Int              @default(0)
  nextAttemptAt     DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  billingAttempts   BillingAttempt[]

  @@unique([shop, contractId])
  @@index([shop, customerId])
  @@index([nextAttemptAt])
}

// Every charge the app asks Shopify to make. The idempotency key is unique,
// so the same attempt can never be recorded or charged twice.
model BillingAttempt {
  id               String     @id @default(cuid())
  membershipId     String
  membership       Membership @relation(fields: [membershipId], references: [id])
  cycleIndex       Int
  attempt          Int
  idempotencyKey   String     @unique
  shopifyAttemptId String?    @unique // gid://shopify/SubscriptionBillingAttempt/...
  state            String // PENDING, SUCCEEDED, FAILED, ACTION_REQUIRED
  errorCode        String?
  orderId          String? // gid://shopify/Order/... when it succeeds
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([membershipId, cycleIndex, attempt])
}
